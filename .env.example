# Copy this file to .env and fill in real values. .env is git-ignored; this file is the
# safe template that is committed.

# --- Database (MySQL 8) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=srct
DB_USER=srct
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- App ---
APP_TIMEZONE=Asia/Riyadh
FRONTEND_URL=http://localhost:5173
SEED_PASSWORD=change-me-seed
# Where uploaded contractor documents are stored (a named Docker volume in compose).
UPLOAD_DIR=/data/uploads
# Required: at least 32 characters, and the app refuses to start while it still begins
# with "change-me". Generate a real value with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- Frontend (passed into the frontend container by docker-compose) ---
VITE_API_URL=http://localhost:8000
