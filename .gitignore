 # Secrets: real passwords and the JWT key live here. Never push this file.
# (.env.example is NOT ignored, because it is the safe template we share.)
.env

# Python cache files. Python recreates them automatically when the code runs.
__pycache__/
*.py[cod]

# Local Python virtual environment. Each developer creates their own.
.venv/
venv/

# Test and code-check caches. They are recreated on every run.
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend libraries. Very large, and reinstalled with one command: npm install
node_modules/

# Frontend build output and temporary files. Recreated with: npm run build
dist/
.vite/
*.tsbuildinfo

# Uploaded contractor documents. This is user data, not source code.
uploads/
docs/ui-refresh
docs/erd.png

# Celery Beat schedule file. Created automatically when the scheduler runs.
celerybeat-schedule*

# Log files created while the app is running.
*.log

# Operating system files (macOS and Windows). Not related to the project.
.DS_Store
Thumbs.db

# Editor settings. Personal to each developer.
.vscode/
.idea/